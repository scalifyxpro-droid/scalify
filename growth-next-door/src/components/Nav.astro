---
---
<header class="nav-header">
  <div class="wrap nav-inner">
    <a href="/" class="brand-link" title="Scalify - A Digital Marketing Company">
      <span class="serif nav-logo">Scalify - A Digital Marketing Company</span>
    </a>
    <nav class="nav-links" aria-label="Main Navigation">
      <a href="/services" class="nav-link">Services</a>
      <a href="/countries" class="nav-link">Locations</a>
      <a href="/#contact" class="nav-cta">Talk to a Strategist →</a>
    </nav>
  </div>
</header>

<style>
  .nav-header {
    border-bottom: 1px solid #e2ddd0;
    background: #f7f5f0;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    gap: 16px;
  }
  .brand-link {
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  .nav-logo {
    font-size: 20px;
    font-weight: 600;
    color: #1c1c1a;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
  }
  .nav-link {
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    color: #4a453c;
    transition: color 0.15s ease;
  }
  .nav-link:hover {
    color: #1c1c1a;
  }
  .nav-cta {
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    background: #1c1c1a;
    color: #f7f5f0;
    padding: 9px 16px;
    border-radius: 6px;
    transition: background 0.15s ease;
    white-space: nowrap;
  }
  .nav-cta:hover {
    background: #38342d;
    color: #fff;
  }

  @media (max-width: 860px) {
    .nav-logo {
      font-size: 16px;
    }
  }

  @media (max-width: 680px) {
    .nav-inner {
      padding: 12px 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .nav-logo {
      font-size: 15px;
    }
    .nav-links {
      width: 100%;
      justify-content: space-between;
      gap: 10px;
    }
    .nav-link {
      font-size: 13px;
    }
    .nav-cta {
      padding: 6px 12px;
      font-size: 12px;
    }
  }
</style>
